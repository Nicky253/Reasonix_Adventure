# Reasonix Firebase Configuration
# Go to Firebase Console (https://console.firebase.google.com/) -> Select project "reasonix-adventure" -> Add Web App -> Copy Config values.

EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=reasonix-adventure.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=reasonix-adventure
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=reasonix-adventure.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID_HERE
